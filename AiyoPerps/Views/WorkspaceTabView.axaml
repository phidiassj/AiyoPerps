<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AiyoPerps.Controls"
             xmlns:models="clr-namespace:AiyoPerps.Models"
             xmlns:vm="clr-namespace:AiyoPerps.ViewModels"
             x:Class="AiyoPerps.Views.WorkspaceTabView">
  <Grid RowDefinitions="Auto,*" RowSpacing="10" Margin="0,6,0,0">
    <Border Grid.Row="0" IsVisible="{Binding IsUnconfigured}" Classes="card">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock Text="{Binding L[Main_AccountWallet]}" VerticalAlignment="Center" Classes="label" />
        <ComboBox Width="520"
                  ItemsSource="{Binding AvailableAccounts}"
                  SelectedItem="{Binding SelectedAccount}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="models:AccountProfile">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Content="{Binding L[Main_Enable]}" Command="{Binding ConfirmActivationCommand}" Classes="cta" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" IsVisible="{Binding IsConfigured}" RowDefinitions="Auto,*" RowSpacing="8" SizeChanged="OnWorkspaceSizeChanged">
      <Border Classes="card" Padding="10">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="{Binding L[Main_Symbol]}" VerticalAlignment="Center" Classes="label" />
          <ComboBox Width="180"
                    ItemsSource="{Binding SymbolOptions}"
                    SelectedItem="{Binding SelectedSymbolOption, Mode=TwoWay}"
                    IsEnabled="{Binding CanEditMarketSessionSettings}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SymbolOptionItem">
                <TextBlock Text="{Binding Display}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
            <ComboBox.SelectionBoxItemTemplate>
              <DataTemplate x:DataType="vm:SymbolOptionItem">
                <TextBlock Text="{Binding Display}" />
              </DataTemplate>
            </ComboBox.SelectionBoxItemTemplate>
          </ComboBox>
          <TextBlock Text="{Binding L[Main_Interval]}" VerticalAlignment="Center" Classes="label" />
          <ComboBox Width="120"
                    ItemsSource="{Binding Intervals}"
                    SelectedItem="{Binding SelectedInterval}"
                    IsEnabled="{Binding CanEditMarketSessionSettings}" />
          <TextBlock Text="{Binding L[Main_Status]}" VerticalAlignment="Center" Margin="12,0,0,0" Classes="label" />
          <TextBlock Text="{Binding ConnectionStatus}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding L[Main_LastEvent]}" VerticalAlignment="Center" Margin="12,0,0,0" Classes="label" />
          <TextBlock Text="{Binding LastMarketEventDisplay}" VerticalAlignment="Center" />
          <Button Content="{Binding L[Main_RefreshData]}"
                  Command="{Binding RefreshDataCommand}"
                  Margin="12,0,0,0"
                  Classes="ghost" />
        </StackPanel>
      </Border>

      <Grid Grid.Row="1"
            ColumnDefinitions="*,604"
            ColumnSpacing="6"
            RowDefinitions="*">
        <Border Grid.Column="0" Classes="card">
          <Grid RowDefinitions="Auto,*" RowSpacing="8">
            <StackPanel Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
              <TextBlock Text="{Binding L[Chart_Title]}"
                         FontWeight="Bold"
                         FontSize="20"
                         Foreground="#D9F0F5" />
              <TextBlock Text="{Binding CandleStatusDisplay}"
                         FontFamily="Consolas"
                         FontSize="18"
                         Foreground="#74D0C9"
                         TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center" />
            </StackPanel>
            <Grid Grid.Row="1">
              <controls:CandleChartControl MinHeight="220"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Stretch"
                                           Candles="{Binding CandleSeries}"
                                           HoverCandleStatus="{Binding HoverCandleStatus, Mode=TwoWay}" />
            </Grid>
          </Grid>
        </Border>

        <Grid Grid.Column="1" ColumnDefinitions="280,6,320" RowDefinitions="*">
          <Grid Grid.Column="0"
                RowDefinitions="*,Auto,Auto"
                IsVisible="{Binding IsOrderBookVisible}">
            <Border Grid.Row="0" Classes="card">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto,100" VerticalAlignment="Center">
                  <TextBlock Grid.Column="0"
                             Text="{Binding L[OrderBook_Title]}"
                             FontWeight="Bold"
                             FontSize="20"
                             Foreground="#D9F0F5"
                             VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding L[OrderBook_TickSize]}"
                             Classes="label"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0" />
                  <ComboBox Grid.Column="2"
                            ItemsSource="{Binding OrderBookTickSizeOptions}"
                            SelectedItem="{Binding SelectedOrderBookTickSize}" />
                </Grid>

                <Grid ColumnDefinitions="*,*,*" Margin="0,2,0,0">
                  <TextBlock Grid.Column="0" Text="{Binding L[OrderBook_Price]}" Classes="label" HorizontalAlignment="Left" />
                  <TextBlock Grid.Column="1" Text="{Binding L[OrderBook_Size]}" Classes="label" HorizontalAlignment="Left" />
                  <TextBlock Grid.Column="2" Text="{Binding L[OrderBook_Total]}" Classes="label" HorizontalAlignment="Left" />
                </Grid>

                <ItemsControl ItemsSource="{Binding AskLevels}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="3" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:OrderBookLevelRow">
                      <Border Background="{Binding RowBackgroundHex}" CornerRadius="4" Padding="6,3">
                        <Grid ColumnDefinitions="*,*,*">
                          <TextBlock Grid.Column="0" Text="{Binding PriceText}" Foreground="{Binding PriceHex}" HorizontalAlignment="Left" FontFamily="Consolas" />
                          <TextBlock Grid.Column="1" Text="{Binding SizeText}" Foreground="#9DB9C4" HorizontalAlignment="Left" FontFamily="Consolas" />
                          <TextBlock Grid.Column="2" Text="{Binding TotalText}" Foreground="{Binding TotalHex}" HorizontalAlignment="Left" FontFamily="Consolas" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Background="#112C36" BorderBrush="#1D556A" BorderThickness="1" CornerRadius="5" Padding="8,4">
                  <TextBlock Text="{Binding SpreadText}" Foreground="#85D9E9" FontFamily="Consolas" HorizontalAlignment="Center" />
                </Border>

                <ItemsControl ItemsSource="{Binding BidLevels}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="3" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:OrderBookLevelRow">
                      <Border Background="{Binding RowBackgroundHex}" CornerRadius="4" Padding="6,3">
                        <Grid ColumnDefinitions="*,*,*">
                          <TextBlock Grid.Column="0" Text="{Binding PriceText}" Foreground="{Binding PriceHex}" HorizontalAlignment="Left" FontFamily="Consolas" />
                          <TextBlock Grid.Column="1" Text="{Binding SizeText}" Foreground="#9DB9C4" HorizontalAlignment="Left" FontFamily="Consolas" />
                          <TextBlock Grid.Column="2" Text="{Binding TotalText}" Foreground="{Binding TotalHex}" HorizontalAlignment="Left" FontFamily="Consolas" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Grid.Row="1"
                    Height="8"
                    Background="Transparent"
                    IsVisible="{Binding IsRecentTradesPanelVisible}" />

            <Border Grid.Row="2"
                    Height="200"
                    Classes="card"
                    IsVisible="{Binding IsRecentTradesPanelVisible}">
              <Grid RowDefinitions="Auto,Auto,*" RowSpacing="6">
                <TextBlock Text="{Binding L[OrderBook_RecentTrades]}"
                           FontWeight="Bold"
                           FontSize="16"
                           Foreground="#D9F0F5" />
                <Grid Grid.Row="1" ColumnDefinitions="1.3*,0.9*,1*,1*" Margin="0,2,0,0">
                  <TextBlock Grid.Column="0" Text="{Binding L[OrderBook_Time]}" Classes="label" HorizontalAlignment="Left" />
                  <TextBlock Grid.Column="1" Text="{Binding L[OrderBook_Side]}" Classes="label" HorizontalAlignment="Left" />
                  <TextBlock Grid.Column="2" Text="{Binding L[OrderBook_Price]}" Classes="label" HorizontalAlignment="Left" />
                  <TextBlock Grid.Column="3" Text="{Binding L[OrderBook_Size]}" Classes="label" HorizontalAlignment="Left" />
                </Grid>
                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl ItemsSource="{Binding RecentTrades}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Spacing="3" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:RecentTradeRow">
                        <Border Background="#0E212C" CornerRadius="4" Padding="6,3">
                          <Grid ColumnDefinitions="1.3*,0.9*,1*,1*">
                            <TextBlock Grid.Column="0" Text="{Binding TimeText}" Foreground="#9CBAC5" FontFamily="Consolas" HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="1" Text="{Binding Side}" Foreground="{Binding SideHex}" HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="2" Text="{Binding PriceText}" Foreground="{Binding PriceHex}" HorizontalAlignment="Left" FontFamily="Consolas" />
                            <TextBlock Grid.Column="3" Text="{Binding SizeText}" Foreground="#9CBAC5" HorizontalAlignment="Left" FontFamily="Consolas" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>
            </Border>
          </Grid>

          <Border Grid.Column="1" Background="#0C1D27" IsVisible="{Binding IsOrderBookVisible}" />

          <Border Grid.Column="2" Classes="card">
            <TabControl SelectedIndex="{Binding SelectedOrderPanelTabIndex}">
              <TabControl.Styles>
                <Style Selector="TabItem">
                  <Setter Property="FontWeight" Value="Bold" />
                  <Setter Property="FontSize" Value="20" />
                  <Setter Property="Foreground" Value="#D9F0F5" />
                  <Setter Property="Padding" Value="8,6" />
                </Style>
              </TabControl.Styles>
              <TabItem Header="{Binding L[OrderPanel_Tab_Order]}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Spacing="8">
                    <TextBlock Text="{Binding L[OrderPanel_OrderType]}" Classes="label" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                      <RadioButton Content="{Binding OrderTypes[0]}"
                                   GroupName="OrderTypeGroup"
                                   IsChecked="{Binding IsMarketOrderSelected}" />
                      <RadioButton Content="{Binding OrderTypes[1]}"
                                   GroupName="OrderTypeGroup"
                                   IsChecked="{Binding IsLimitOrderSelected}" />
                    </StackPanel>
                    <TextBlock Text="{Binding L[OrderPanel_Action]}" Classes="label" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                      <RadioButton Content="{Binding OrderSides[0]}"
                                   GroupName="OrderSideGroup"
                                   IsChecked="{Binding IsLongOrderSelected}" />
                      <RadioButton Content="{Binding OrderSides[1]}"
                                   GroupName="OrderSideGroup"
                                   IsChecked="{Binding IsShortOrderSelected}" />
                    </StackPanel>
                    <TextBlock Text="{Binding L[OrderPanel_Leverage]}" Classes="label" />
                    <TextBox Watermark="{Binding L[OrderPanel_Leverage_Example]}" Text="{Binding OrderLeverage}" />
                    <TextBlock Text="{Binding L[OrderPanel_MarginMode]}" Classes="label" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                      <RadioButton Content="Cross"
                                   GroupName="MarginModeGroup"
                                   IsChecked="{Binding IsCrossMarginModeSelected}" />
                      <RadioButton Content="Isolated"
                                   GroupName="MarginModeGroup"
                                   IsChecked="{Binding IsIsolatedMarginModeSelected}"
                                   IsEnabled="{Binding CanUseIsolatedMarginMode}" />
                    </StackPanel>
                    <TextBlock Text="{Binding MarginModeSupportText}"
                               Classes="label"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding L[OrderPanel_Amount]}" Classes="label" />
                    <Grid ColumnDefinitions="*,100" ColumnSpacing="8">
                      <TextBox Grid.Column="0" Watermark="{Binding L[OrderPanel_Amount_Example]}" Text="{Binding OrderQuantity}" />
                      <ComboBox Grid.Column="1"
                                ItemsSource="{Binding OrderAmountUnitOptions}"
                                SelectedItem="{Binding SelectedAmountUnit}" />
                    </Grid>
                    <TextBlock Text="{Binding L[OrderPanel_LimitPrice]}" Classes="label" IsVisible="{Binding IsLimitOrder}" />
                    <TextBox Watermark="{Binding L[OrderPanel_LimitPrice_Placeholder]}"
                             Text="{Binding OrderPrice}"
                             IsVisible="{Binding IsLimitOrder}" />
                    <TextBlock Text="{Binding L[OrderPanel_EstimatedCostUsd]}" Classes="label" />
                    <TextBlock Text="{Binding EstimatedCostUsd}" Foreground="#74D0C9" FontFamily="Consolas" />
                    <TextBlock Text="{Binding L[OrderPanel_EstimatedLiqPrice]}" Classes="label" />
                    <TextBlock Text="{Binding EstimatedLiquidationPrice}" Foreground="#74D0C9" FontFamily="Consolas" />
                    <Button Content="{Binding L[OrderPanel_SubmitOrder]}" Command="{Binding SubmitOrderCommand}" Classes="cta" />
                  </StackPanel>
                </ScrollViewer>
              </TabItem>

              <TabItem Header="{Binding L[OrderPanel_Tab_Positions]}">
                <Grid RowDefinitions="*,Auto">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding ActivePositions}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Spacing="8" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PositionPanelRow">
                          <Border Background="#0E212C" BorderBrush="#26414C" BorderThickness="1" CornerRadius="8" Padding="10">
                            <StackPanel Spacing="4">
                              <TextBlock Text="{Binding DisplaySymbol}" FontWeight="Bold" Foreground="#D9F0F5" />
                              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Text="{Binding AmountLabel}" Classes="label" />
                                <TextBlock Grid.Column="1" Text="{Binding ContractAmount}" HorizontalAlignment="Left" />
                              </Grid>
                              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Text="{Binding LeverageLabel}" Classes="label" />
                                <TextBlock Grid.Column="1" Text="{Binding Leverage}" HorizontalAlignment="Left" />
                              </Grid>
                              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Text="{Binding MarginModeLabel}" Classes="label" />
                                <TextBlock Grid.Column="1" Text="{Binding MarginMode}" HorizontalAlignment="Left" />
                              </Grid>
                              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Text="{Binding EntryPriceLabel}" Classes="label" />
                                <TextBlock Grid.Column="1" Text="{Binding EntryPriceText}" FontFamily="Consolas" HorizontalAlignment="Left" />
                              </Grid>
                              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Text="{Binding MarkPriceLabel}" Classes="label" />
                                <TextBlock Grid.Column="1" Text="{Binding MarkPriceText}" FontFamily="Consolas" HorizontalAlignment="Left" />
                              </Grid>
                              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Text="{Binding UnrealizedPctLabel}" Classes="label" />
                                <TextBlock Grid.Column="1" Text="{Binding UnrealizedPnlPctText}" Foreground="{Binding UnrealizedPnlHex}" FontFamily="Consolas" HorizontalAlignment="Left" />
                              </Grid>
                              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Text="{Binding UnrealizedUsdLabel}" Classes="label" />
                                <TextBlock Grid.Column="1" Text="{Binding UnrealizedPnlUsdText}" Foreground="{Binding UnrealizedPnlUsdHex}" FontFamily="Consolas" HorizontalAlignment="Left" />
                              </Grid>
                              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Text="{Binding RealizedUsdLabel}" Classes="label" />
                                <TextBlock Grid.Column="1" Text="{Binding RealizedPnlUsdText}" Foreground="{Binding RealizedPnlHex}" FontFamily="Consolas" HorizontalAlignment="Left" />
                              </Grid>
                              <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" Margin="0,6,0,0">
                                <TextBlock Grid.Column="0" Text="{Binding CloseLabel}" Classes="label" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding ClosePrice, Mode=TwoWay}"
                                         Watermark="{Binding ClosePriceWatermark}" />
                                <Button Grid.Column="2"
                                        Content="{Binding CloseLimitLabel}"
                                        IsEnabled="{Binding CanUseRestingLimitClose}"
                                        Command="{Binding ClosePositionLimitCommand}"
                                        CommandParameter="{Binding}" />
                                <Button Grid.Column="3"
                                        Content="{Binding CloseMarketLabel}"
                                        Command="{Binding ClosePositionMarketCommand}"
                                        CommandParameter="{Binding}"
                                        Classes="cta" />
                              </Grid>
                              <TextBlock Text="{Binding CloseLimitSupportText}"
                                         Classes="label"
                                         Margin="0,4,0,0"
                                         Foreground="#E5B971"
                                         TextWrapping="Wrap"
                                         IsVisible="{Binding IsRestingLimitCloseUnavailable}" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                  <TextBlock Grid.Row="1"
                             Text="{Binding L[Empty_NoPositions]}"
                             Classes="label"
                             Margin="0,8,0,0"
                             IsVisible="{Binding HasNoActivePositions}" />
                </Grid>
              </TabItem>

              <TabItem Header="{Binding L[OrderPanel_Tab_Orders]}">
                <Grid RowDefinitions="*,Auto">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding PendingOrders}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Spacing="8" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PendingOrderPanelRow">
                          <Border Background="#0E212C" BorderBrush="#26414C" BorderThickness="1" CornerRadius="8" Padding="10">
                            <StackPanel Spacing="4">
                              <TextBlock Text="{Binding DisplaySymbol}" FontWeight="Bold" Foreground="#D9F0F5" />
                              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Text="{Binding AmountLabel}" Classes="label" />
                                <TextBlock Grid.Column="1" Text="{Binding ContractAmount}" HorizontalAlignment="Left" />
                              </Grid>
                              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Text="{Binding LeverageLabel}" Classes="label" />
                                <TextBlock Grid.Column="1" Text="{Binding Leverage}" HorizontalAlignment="Left" />
                              </Grid>
                              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Text="{Binding MarginModeLabel}" Classes="label" />
                                <TextBlock Grid.Column="1" Text="{Binding MarginMode}" HorizontalAlignment="Left" />
                              </Grid>
                              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Text="{Binding LimitPriceLabel}" Classes="label" />
                                <TextBlock Grid.Column="1" Text="{Binding LimitPrice}" FontFamily="Consolas" HorizontalAlignment="Left" />
                              </Grid>
                              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Text="{Binding StatusLabel}" Classes="label" />
                                <TextBlock Grid.Column="1" Text="{Binding Status}" HorizontalAlignment="Left" />
                              </Grid>
                              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding OrderIdLabel}"
                                           Classes="label" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding VenueOrderIdDisplay}"
                                           Classes="label"
                                           FontFamily="Consolas"
                                           HorizontalAlignment="Left" />
                              </Grid>
                              <Button Content="{Binding CancelLabel}"
                                      MinWidth="72"
                                      HorizontalAlignment="Left"
                                      Margin="0,6,0,0"
                                      Command="{Binding CancelPendingOrderCommand}"
                                      CommandParameter="{Binding}" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                  <TextBlock Grid.Row="1"
                             Text="{Binding L[Empty_NoPendingOrders]}"
                             Classes="label"
                             Margin="0,8,0,0"
                             IsVisible="{Binding HasNoPendingOrders}" />
                </Grid>
              </TabItem>
              <TabItem Header="{Binding L[OrderPanel_Tab_Balances]}">
                <Grid RowDefinitions="Auto,*">
                  <Grid ColumnDefinitions="1.5*,0.9*,0.9*" ColumnSpacing="10" Margin="0,0,0,6">
                    <TextBlock Grid.Column="0" Text="{Binding L[Balance_Coin]}" Classes="label" HorizontalAlignment="Left" TextAlignment="Left" />
                    <TextBlock Grid.Column="1" Text="{Binding L[Balance_Quantity]}" Classes="label" HorizontalAlignment="Left" />
                    <TextBlock Grid.Column="2" Text="USD" Classes="label" HorizontalAlignment="Left" />
                  </Grid>
                  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Balances}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Spacing="4" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:BalancePanelRow">
                          <Border Background="#0E212C" CornerRadius="6" Padding="8,4">
                            <Grid ColumnDefinitions="1.5*,0.9*,0.9*" ColumnSpacing="10">
                              <TextBlock Grid.Column="0"
                                         Text="{Binding Coin}"
                                         HorizontalAlignment="Left"
                                         TextAlignment="Left"
                                         TextTrimming="CharacterEllipsis"
                                         TextWrapping="NoWrap"
                                         MaxLines="1" />
                              <TextBlock Grid.Column="1" Text="{Binding QuantityText}" FontFamily="Consolas" HorizontalAlignment="Left" />
                              <TextBlock Grid.Column="2" Text="{Binding UsdText}" FontFamily="Consolas" HorizontalAlignment="Left" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                  <TextBlock Grid.Row="1"
                             Text="{Binding L[Empty_NoBalances]}"
                             Classes="label"
                             Margin="0,8,0,0"
                             IsVisible="{Binding HasNoBalances}" />
                </Grid>
              </TabItem>
            </TabControl>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
