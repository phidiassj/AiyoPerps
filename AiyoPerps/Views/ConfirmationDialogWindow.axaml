<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AiyoPerps.ViewModels"
        x:Class="AiyoPerps.Views.ConfirmationDialogWindow"
        x:DataType="vm:ConfirmationDialogViewModel"
        Width="420"
        Height="220"
        MinWidth="360"
        MinHeight="200"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Icon="avares://AiyoPerps/Assets/logo.ico"
        Title="{Binding Title}">
  <Grid RowDefinitions="*,Auto" Margin="18" RowSpacing="16">
    <TextBlock Text="{Binding Message}"
               TextWrapping="Wrap"
               VerticalAlignment="Center" />

    <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="10">
      <Button Content="{Binding CancelText}" Click="OnCancelClick" />
      <Button Content="{Binding ConfirmText}" Click="OnConfirmClick" Classes="cta" />
    </StackPanel>
  </Grid>
</Window>
